{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "vscode": {
        "type": "local",
        // Replace <BRIDGE_DIR> with the folder holding these branch files, e.g.
        // Windows: "C:\\Tools\\vscode-bridge\\vscode-bridge-mcp.mjs"
        // macOS:   "/Users/you/tools/vscode-bridge/vscode-bridge-mcp.mjs"
        // (The install scripts register this automatically -- this file
        // is only for manual setup.)
        "command": ["node", "<BRIDGE_DIR>\\vscode-bridge-mcp.mjs"]
      }
    }
  }
}
